{
  "name": "dream-local",
  "version": "1.0.0",
  "description": "Your personal local AI assistant — Phi-4 14B, fully offline, runs on Apple Silicon",
  "keywords": [
    "ai",
    "assistant",
    "llm",
    "phi-4",
    "offline",
    "cli",
    "local"
  ],
  "author": "Jonas Kabalo",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dream": "./dist/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc && chmod +x dist/main.js",
    "prepublishOnly": "npm run build && npm run typecheck",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "setup-github": "tsx scripts/setup-github.ts",
    "setup-gmail": "tsx scripts/setup-gmail.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.6.2",
    "googleapis": "^172.0.0",
    "node-llama-cpp": "^3.18.1",
    "pdf-parse": "^2.4.5"
  }
}
